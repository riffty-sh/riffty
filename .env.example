# 12-Factor Runtime Configuration for `riffty` CLI, `riffty-ab`, & MCP Reviewer Server
RIFFTY_FORMAT=text
RIFFTY_MAX_PASSES=10

# Optional path to a Refaster YAML ruleset:
# RIFFTY_RULES_PATH=rules/default.yml

# Optional default repository root for `riffty mcp` / `riffty_mcp`:
# RIFFTY_WORKSPACE_ROOT=.

# Optional Java Tier 2 sidecar overrides (auto-discovered by default):
# RIFFTY_JAVA_BIN=/path/to/jdk-25/bin/java
# RIFFTY_JAVA_JAR=/path/to/riffty-java-runner.jar

# Optional Connected-Mode Infrastructure Intelligence providers:
# PROMETHEUS_URL=http://localhost:9090
# PROMETHEUS_BEARER_TOKEN=
# OPENCOST_URL=http://localhost:9003
# OPENCOST_BEARER_TOKEN=
