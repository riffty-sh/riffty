{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "projectName": "riffty",
  "projectDescription": "Hexagonal (Ports & Adapters), Deterministic, Type-Aware Static Analysis, Byte-Offset Auto-Remediation & MCP Reviewer Engine for Python in Rust",
  "ontology": {
    "definitionFile": "docs/ontology.md",
    "ubiquitousLanguageFile": "AGENTS.md"
  },
  "documentation": {
    "sourceDirectory": "docs",
    "primaryDocs": [
      "docs/ontology.md",
      "docs/ach.md"
    ]
  },
  "deliverables": {
    "affirmationMatrixJson": "docs/affirmation-matrix.json",
    "affirmationMatrixMarkdown": "docs/affirmation-matrix.md",
    "userStoriesFile": "docs/user-stories.md",
    "technicalTasksFile": "docs/technical-tasks.md",
    "demoPresentationsDirectory": "docs/demos",
    "onboardingFile": "docs/onboarding.md"
  },
  "designSystem": {
    "tokensFile": "design-system/tokens/tokens.json",
    "componentSpecsFile": "design-system/components/specifications.md"
  },
  "ecosystem": "rust",
  "language": "rust",
  "engineeringDiscipline": {
    "mattPocock": {
      "grilling": true,
      "deepModules": true,
      "tracerBullets": true
    },
    "addyOsmani": {
      "doubtDrivenDevelopment": true,
      "sourceDrivenDevelopment": true,
      "constraintDrivenDevelopment": true,
      "parallelShipGate": true
    }
  },
  "testing": {
    "unitTestRunner": "RUSTFLAGS=\"-D warnings\" cargo test --workspace",
    "e2eTestRunner": "RUSTFLAGS=\"-D warnings\" cargo test --workspace --tests",
    "slowMoDelayMs": 600
  },
  "gates": {
    "minPlanAffirmationScore": 95,
    "requireZeroOrphans": true
  }
}

